# ReturnZero (VITO) STT — https://developers.rtzr.ai
RTZR_CLIENT_ID=
RTZR_CLIENT_SECRET=

# Anthropic API — 분류/문장 변환
ANTHROPIC_API_KEY=

# 서버 포트 (기본 8787)
PORT=8787

# Raspberry Pi device_id -> bearer token JSON. 실제 토큰은 커밋하지 마세요.
# 미설정 시 샘플 재생은 동작하지만 POST /api/v1/audio-chunks는 503입니다.
DEVICE_AUTH_TOKENS={"station-pi-01":"replace-with-a-long-random-token"}

# 오디오 청크 세션 (아래 값은 기본값)
MAX_ACTIVE_SESSIONS=8
SESSION_INACTIVITY_MS=15000
FINALIZED_RECEIPT_TTL_MS=60000
SESSION_QUEUE_MAX_MS=8000
MAX_SESSION_CHUNKS=1800
MAX_COMPLETED_RECEIPTS=1024
VITO_FRAME_MS=100
VITO_DOMAIN=MEETING
VITO_CONNECT_TIMEOUT_MS=10000
VITO_FINAL_WAIT_MS=10000
CLASSIFY_TIMEOUT_MS=15000

# HTTP 및 배포 경계. 외부 배포는 HTTPS reverse proxy 뒤에서 REQUIRE_HTTPS=true 사용.
REQUEST_TIMEOUT_MS=10000
HEADERS_TIMEOUT_MS=5000
KEEP_ALIVE_TIMEOUT_MS=5000
REQUIRE_HTTPS=false
